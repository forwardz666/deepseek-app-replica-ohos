{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "DeepSeek App Replica HarmonyOS shell",
    "mainElement": "EntryAbility",
    "deliveryWithInstall": true,
    "pages": "$profile:main_pages",
    "deviceTypes": ["default", "tablet", "2in1"],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_permission_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "DeepSeek App Replica web host",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "orientation": "unspecified",
        "supportWindowMode": ["fullscreen", "split", "floating"],
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ]
  }
}
